{
  "name": "gradle",
  "title": {"en":"Gradle","vi":"Gradle"},
  "tools": ["gradle"],
  "origin": "tldr-pages (CC BY 4.0), https://github.com/tldr-pages/tldr",
  "version": 1,
  "commands": [
    {"name":{"en":"Compile a package","vi":"Build dự án"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle build","tags":["gradle"]},
    {"name":{"en":"Exclude test task","vi":"Build, bỏ qua test"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle build --exclude-task test","tags":["gradle"]},
    {"name":{"en":"Run in offline mode to prevent Gradle from accessing the network during builds","vi":"Build offline (không truy cập mạng)"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle build --offline","tags":["gradle"]},
    {"name":{"en":"Clear the build directory","vi":"Xoá thư mục build"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle clean","tags":["gradle"]},
    {"name":{"en":"Build an Android Package (APK) in release mode","vi":"Build APK Android bản release"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle assembleRelease","tags":["gradle"]},
    {"name":{"en":"List the main tasks","vi":"Liệt kê các task chính"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle tasks","tags":["gradle"]},
    {"name":{"en":"List all the tasks","vi":"Liệt kê mọi task"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle tasks --all","tags":["gradle"]},
    {"name":{"en":"Perform a clean build","vi":"Xoá bản build cũ rồi build lại"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle clean build","tags":["gradle build"]},
    {"name":{"en":"Build with more detailed logging","vi":"Build, in log chi tiết"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle build --info","tags":["gradle build"]},
    {"name":{"en":"Clean a specific subproject in a multi-project build","vi":"Xoá build của một dự án con"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle :{subproject}:clean","tags":["gradle clean"],"params":[{"key":"subproject","type":"text","description":{"en":"subproject","vi":"Tên dự án con"},"required":true}]},
    {"name":{"en":"Clean with more detailed logging","vi":"Xoá build, in log chi tiết"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle clean --info","tags":["gradle clean"]},
    {"name":{"en":"Run all tests","vi":"Chạy mọi test"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle test","tags":["gradle test"]},
    {"name":{"en":"Run tests with detailed output","vi":"Chạy test, in chi tiết"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle test --info","tags":["gradle test"]},
    {"name":{"en":"Run a specific test class","vi":"Chạy một lớp test"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle test --tests {class_name}","tags":["gradle test"],"params":[{"key":"class_name","type":"text","description":{"en":"class_name","vi":"Tên lớp test"},"required":true}]},
    {"name":{"en":"Run tests matching a pattern","vi":"Chạy các test khớp mẫu"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle test --tests \"{pattern}\"","tags":["gradle test"],"params":[{"key":"pattern","type":"text","description":{"en":"pattern","vi":"Mẫu tên test (vd: *UserTest*)"},"required":true}]},
    {"name":{"en":"Rerun tests even if up-to-date","vi":"Chạy lại test kể cả khi không có thay đổi"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle test --rerun","tags":["gradle test"]},
    {"name":{"en":"List tasks in a specific group","vi":"Liệt kê task trong một nhóm"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle tasks --group {group_name}","tags":["gradle tasks"],"params":[{"key":"group_name","type":"text","description":{"en":"group_name","vi":"Tên nhóm task"},"required":true}]},
    {"name":{"en":"List tasks for a specific subproject","vi":"Liệt kê task của một dự án con"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle :{subproject}:tasks","tags":["gradle tasks"],"params":[{"key":"subproject","type":"text","description":{"en":"subproject","vi":"Tên dự án con"},"required":true}]},
    {"name":{"en":"Display all dependencies","vi":"Xem mọi phụ thuộc"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle dependencies","tags":["gradle dependencies"]},
    {"name":{"en":"Display dependencies for a specific configuration","vi":"Xem phụ thuộc của một cấu hình"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle dependencies --configuration {implementation}","tags":["gradle dependencies"],"params":[{"key":"implementation","type":"text","description":{"en":"implementation","vi":"Tên cấu hình (vd: implementation)"},"required":true}]},
    {"name":{"en":"Display dependencies for a specific subproject","vi":"Xem phụ thuộc của một dự án con"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle :{subproject}:dependencies","tags":["gradle dependencies"],"params":[{"key":"subproject","type":"text","description":{"en":"subproject","vi":"Tên dự án con"},"required":true}]},
    {"name":{"en":"Display dependencies and save to a file","vi":"Xem phụ thuộc và lưu ra file"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle dependencies > {dependencies}","tags":["gradle dependencies"],"params":[{"key":"dependencies","type":"path","description":{"en":"path/to/dependencies.txt","vi":"File kết quả"},"required":true}]},
    {"name":{"en":"Generate wrapper with the current Gradle version","vi":"Tạo Gradle wrapper theo phiên bản đang dùng"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle wrapper","tags":["gradle wrapper"]},
    {"name":{"en":"Generate wrapper with a specific Gradle version","vi":"Tạo Gradle wrapper cho một phiên bản"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle wrapper --gradle-version {value}","tags":["gradle wrapper"],"params":[{"key":"value","type":"text","default":"8.5","description":{"en":"8.5","vi":"Phiên bản Gradle"}}]},
    {"name":{"en":"Generate wrapper with a specific distribution type","vi":"Tạo Gradle wrapper với kiểu bản phân phối"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle wrapper --distribution-type {choice}","tags":["gradle wrapper"],"params":[{"key":"choice","type":"text","default":"bin","description":{"en":"one of: bin, all","vi":"bin hoặc all"}}]},
    {"name":{"en":"Generate wrapper using a specific distribution URL","vi":"Tạo Gradle wrapper từ URL bản phân phối"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle wrapper --gradle-distribution-url {url}","tags":["gradle wrapper"],"params":[{"key":"url","type":"host","description":{"en":"url","vi":"URL"},"required":true}]},
    {"name":{"en":"Initialize a new Gradle project interactively","vi":"Tạo dự án Gradle mới (hỏi từng bước)"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle init","tags":["gradle init"]},
    {"name":{"en":"Initialize a project of a specific type","vi":"Tạo dự án theo loại"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle init --type {choice}","tags":["gradle init"],"params":[{"key":"choice","type":"text","default":"basic","description":{"en":"one of: basic, java-application, java-library, ...","vi":"Loại dự án: basic, java-application, java-library…"}}]},
    {"name":{"en":"Initialize a project with a specific DSL","vi":"Tạo dự án với ngôn ngữ build (Groovy/Kotlin)"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle init --dsl {choice}","tags":["gradle init"],"params":[{"key":"choice","type":"text","default":"groovy","description":{"en":"one of: groovy, kotlin","vi":"groovy hoặc kotlin"}}]},
    {"name":{"en":"Initialize a project with a specific test framework","vi":"Tạo dự án với framework test"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle init --test-framework {choice}","tags":["gradle init"],"params":[{"key":"choice","type":"text","default":"junit-jupiter","description":{"en":"one of: junit-jupiter, testng, spock","vi":"junit-jupiter, testng hoặc spock"}}]},
    {"name":{"en":"Initialize a project without interactive prompts","vi":"Tạo dự án không hỏi"},"platform":"both","category":{"en":"Gradle","vi":"Gradle"},"template":"gradle init --type {java-application} --dsl {kotlin} --test-framework {junit-jupiter}","tags":["gradle init"],"params":[{"key":"java-application","type":"text","default":"java-application","description":{"en":"java-application","vi":"Loại dự án"}},{"key":"kotlin","type":"text","description":{"en":"kotlin","vi":"Ngôn ngữ build (groovy/kotlin)"},"required":true},{"key":"junit-jupiter","type":"text","default":"junit-jupiter","description":{"en":"junit-jupiter","vi":"Framework test"}}]}
  ]
}
