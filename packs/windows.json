{
  "name": "windows",
  "version": 1,
  "commands": [
    {"name": {"en": "Show full network configuration", "vi": "Xem cấu hình mạng đầy đủ"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "ipconfig /all",
     "purpose": {"en": "IP, subnet, gateway, DNS servers, MAC and DHCP lease of every adapter.", "vi": "IP, subnet, gateway, DNS, địa chỉ MAC và thời hạn DHCP của mọi card mạng."}, "tags": ["ip", "dns", "mac", "gateway"]},
    {"name": {"en": "Clear the DNS cache", "vi": "Xóa bộ nhớ đệm DNS"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "ipconfig /flushdns",
     "purpose": {"en": "Forgets cached name lookups; use after changing DNS records or hosts.", "vi": "Xóa kết quả tra tên đã lưu; dùng sau khi đổi bản ghi DNS hoặc file hosts."}, "tags": ["dns", "cache"]},
    {"name": {"en": "Renew the IP address (DHCP)", "vi": "Xin lại địa chỉ IP (DHCP)"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "ipconfig /release && ipconfig /renew",
     "purpose": {"en": "Drops the current lease and asks the DHCP server for a new one.", "vi": "Trả IP đang dùng và xin IP mới từ máy chủ DHCP."}, "notes": {"en": "The connection drops for a moment.", "vi": "Mạng sẽ mất kết nối trong giây lát."}, "tags": ["dhcp", "ip"]},
    {"name": {"en": "Ping a host", "vi": "Ping máy"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "ping {host} -n {count}",
     "purpose": {"en": "Checks a host answers and how long the round trip takes.", "vi": "Kiểm tra máy có phản hồi không và độ trễ bao nhiêu."}, "tags": ["ping", "latency", "kết nối"],
     "params": [{"key": "host", "type": "host", "default": "8.8.8.8", "description": {"en": "Host name or IP", "vi": "Tên máy hoặc IP"}, "required": true}, {"key": "count", "type": "number", "default": "4", "description": {"en": "Number of echo requests", "vi": "Số gói gửi"}}]},
    {"name": {"en": "Ping without stopping", "vi": "Ping liên tục"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "ping {host} -t",
     "purpose": {"en": "Keeps pinging until Ctrl+C; useful to watch a link drop or come back.", "vi": "Ping đến khi bấm Ctrl+C; dùng để theo dõi đường mạng rớt hay có lại."}, "tags": ["ping", "monitor"],
     "params": [{"key": "host", "type": "host", "default": "8.8.8.8", "description": {"en": "Host name or IP", "vi": "Tên máy hoặc IP"}, "required": true}]},
    {"name": {"en": "Trace the route to a host", "vi": "Dò đường đi tới máy đích"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "tracert -d {host}",
     "purpose": {"en": "Lists every router on the way and where the delay or loss starts.", "vi": "Liệt kê từng router trên đường đi, thấy chặng nào bắt đầu chậm hoặc mất gói."}, "tags": ["traceroute", "route", "hop"],
     "params": [{"key": "host", "type": "host", "default": "8.8.8.8", "description": {"en": "Destination", "vi": "Máy đích"}, "required": true}]},
    {"name": {"en": "Look up a DNS name", "vi": "Tra tên miền (DNS)"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "nslookup {name} {dns}",
     "purpose": {"en": "Asks a DNS server what a name resolves to.", "vi": "Hỏi máy chủ DNS xem tên miền trỏ về IP nào."}, "tags": ["dns", "domain", "tên miền"],
     "params": [{"key": "name", "type": "host", "default": "example.com", "description": {"en": "Name to resolve", "vi": "Tên cần tra"}, "required": true}, {"key": "dns", "type": "host", "default": "8.8.8.8", "description": {"en": "DNS server to ask", "vi": "Máy chủ DNS"}}]},
    {"name": {"en": "Find the process holding a port", "vi": "Tìm tiến trình đang giữ cổng"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "netstat -ano | findstr :{port}",
     "purpose": {"en": "Connections and the PID using a port; for 'port already in use' errors.", "vi": "Kết nối và PID đang dùng một cổng; dùng khi báo lỗi cổng đã bị chiếm."}, "notes": {"en": "Name of the PID: tasklist /FI \"PID eq <pid>\"", "vi": "Xem tên chương trình của PID: tasklist /FI \"PID eq <pid>\""}, "tags": ["port", "cổng", "pid", "listen"],
     "params": [{"key": "port", "type": "number", "default": "8080", "description": {"en": "Port number", "vi": "Số cổng"}, "required": true}]},
    {"name": {"en": "List listening ports (PowerShell)", "vi": "Liệt kê cổng đang mở (PowerShell)"}, "platform": "windows", "shell": "powershell", "category": {"en": "Network", "vi": "Mạng"}, "template": "Get-NetTCPConnection -State Listen | Sort-Object LocalPort | Select-Object LocalAddress,LocalPort,OwningProcess",
     "purpose": {"en": "Every TCP port waiting for connections and the process that owns it.", "vi": "Mọi cổng TCP đang chờ kết nối và tiến trình sở hữu."}, "tags": ["port", "cổng", "listen", "đang mở"]},
    {"name": {"en": "Test a TCP port on another host", "vi": "Kiểm tra cổng TCP trên máy khác"}, "platform": "windows", "shell": "powershell", "category": {"en": "Network", "vi": "Mạng"}, "template": "Test-NetConnection {host} -Port {port}",
     "purpose": {"en": "Tells whether a port is reachable or blocked (TcpTestSucceeded).", "vi": "Cho biết cổng có thông hay bị chặn (TcpTestSucceeded)."}, "tags": ["port", "firewall", "telnet", "kết nối"],
     "params": [{"key": "host", "type": "host", "default": "10.0.0.1", "description": {"en": "Host", "vi": "Máy cần thử"}, "required": true}, {"key": "port", "type": "number", "default": "443", "description": {"en": "TCP port", "vi": "Cổng TCP"}, "required": true}]},
    {"name": {"en": "Show the ARP table", "vi": "Xem bảng ARP"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "arp -a",
     "purpose": {"en": "IP-to-MAC pairs this PC has seen on the local network.", "vi": "Các cặp IP – MAC máy này đã thấy trong mạng nội bộ."}, "tags": ["arp", "mac", "lan"]},
    {"name": {"en": "Show the routing table", "vi": "Xem bảng định tuyến"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "route print -4",
     "purpose": {"en": "Which gateway each destination network goes through.", "vi": "Mỗi dải mạng đi qua gateway nào."}, "tags": ["route", "gateway", "định tuyến"]},
    {"name": {"en": "List saved Wi-Fi networks", "vi": "Liệt kê Wi-Fi đã lưu"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "netsh wlan show profiles",
     "purpose": {"en": "Wi-Fi profiles stored on this PC.", "vi": "Các mạng Wi-Fi đã lưu trên máy."}, "tags": ["wifi", "wlan"]},
    {"name": {"en": "Show a saved Wi-Fi password", "vi": "Xem mật khẩu Wi-Fi đã lưu"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "netsh wlan show profile name=\"{ssid}\" key=clear",
     "purpose": {"en": "The key of a saved network appears under 'Key Content'.", "vi": "Mật khẩu nằm ở dòng 'Key Content'."}, "notes": {"en": "Needs an administrator prompt for networks of all users.", "vi": "Cần quyền Administrator với mạng của mọi người dùng."}, "tags": ["wifi", "password", "mật khẩu"],
     "params": [{"key": "ssid", "type": "text", "default": "", "description": {"en": "Wi-Fi name", "vi": "Tên Wi-Fi"}, "required": true}]},
    {"name": {"en": "Open a port in Windows Firewall", "vi": "Mở cổng trên Windows Firewall"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "netsh advfirewall firewall add rule name=\"{name}\" dir=in action=allow protocol=TCP localport={port}",
     "purpose": {"en": "Allows incoming TCP connections to a port.", "vi": "Cho phép kết nối TCP đi vào một cổng."}, "notes": {"en": "Run as administrator. Remove with: netsh advfirewall firewall delete rule name=\"<name>\"", "vi": "Chạy bằng quyền Administrator. Gỡ bằng: netsh advfirewall firewall delete rule name=\"<tên>\""}, "tags": ["firewall", "port", "cổng"],
     "params": [{"key": "name", "type": "text", "default": "Cmdex rule", "description": {"en": "Rule name", "vi": "Tên luật"}, "required": true}, {"key": "port", "type": "number", "default": "8080", "description": {"en": "Port", "vi": "Cổng"}, "required": true}]},
    {"name": {"en": "Resolve a DNS record", "vi": "Tra bản ghi DNS"}, "platform": "windows", "shell": "powershell", "category": {"en": "Network", "vi": "Mạng"}, "template": "Resolve-DnsName {name} -Type {type}",
     "purpose": {"en": "A, AAAA, MX, TXT, CNAME… records of a name.", "vi": "Bản ghi A, AAAA, MX, TXT, CNAME… của tên miền."}, "tags": ["dns", "mx", "txt"],
     "params": [{"key": "name", "type": "host", "default": "example.com", "description": {"en": "Name", "vi": "Tên miền"}, "required": true}, {"key": "type", "type": "text", "default": "A", "description": {"en": "Record type", "vi": "Loại bản ghi"}}]},
    {"name": {"en": "Show a web server's response headers", "vi": "Xem header phản hồi của web"}, "platform": "windows", "shell": "cmd", "category": {"en": "Network", "vi": "Mạng"}, "template": "curl.exe -I {url}",
     "purpose": {"en": "Status code, redirects and headers without downloading the page.", "vi": "Mã trạng thái, chuyển hướng và header mà không tải trang."}, "tags": ["http", "web", "curl"],
     "params": [{"key": "url", "type": "text", "default": "https://example.com", "description": {"en": "Address", "vi": "Địa chỉ"}, "required": true}]},

    {"name": {"en": "System summary", "vi": "Thông tin hệ thống"}, "platform": "windows", "shell": "cmd", "category": {"en": "System", "vi": "Hệ thống"}, "template": "systeminfo",
     "purpose": {"en": "Windows version, install date, boot time, RAM, hotfixes, domain.", "vi": "Phiên bản Windows, ngày cài, lần khởi động, RAM, bản vá, domain."}, "tags": ["os", "version", "ram", "phiên bản"]},
    {"name": {"en": "Who am I (user, groups, privileges)", "vi": "Tài khoản hiện tại, nhóm và quyền"}, "platform": "windows", "shell": "cmd", "category": {"en": "Users", "vi": "Người dùng"}, "template": "whoami /all",
     "purpose": {"en": "Current account, its SID, groups and privileges.", "vi": "Tài khoản đang dùng, SID, các nhóm và quyền."}, "tags": ["user", "admin", "quyền"]},
    {"name": {"en": "BIOS serial number", "vi": "Số serial của máy (BIOS)"}, "platform": "windows", "shell": "powershell", "category": {"en": "System", "vi": "Hệ thống"}, "template": "Get-CimInstance Win32_BIOS | Select-Object Manufacturer,SerialNumber,SMBIOSBIOSVersion",
     "purpose": {"en": "Serial number and BIOS version, e.g. for warranty checks.", "vi": "Số serial và phiên bản BIOS, ví dụ để tra bảo hành."}, "tags": ["serial", "bios", "bảo hành"]},
    {"name": {"en": "Restart after a delay", "vi": "Khởi động lại sau một khoảng"}, "platform": "windows", "shell": "cmd", "category": {"en": "System", "vi": "Hệ thống"}, "template": "shutdown /r /t {seconds}",
     "purpose": {"en": "Restarts Windows after the delay; cancel with shutdown /a.", "vi": "Khởi động lại Windows sau số giây; hủy bằng shutdown /a."}, "tags": ["restart", "reboot", "khởi động lại"],
     "params": [{"key": "seconds", "type": "number", "default": "60", "description": {"en": "Delay in seconds", "vi": "Số giây chờ"}}]},
    {"name": {"en": "Cancel a scheduled shutdown", "vi": "Hủy lệnh tắt/khởi động lại"}, "platform": "windows", "shell": "cmd", "category": {"en": "System", "vi": "Hệ thống"}, "template": "shutdown /a",
     "purpose": {"en": "Stops a pending shutdown or restart.", "vi": "Dừng lệnh tắt máy hoặc khởi động lại đang đếm ngược."}, "tags": ["shutdown", "cancel", "hủy"]},
    {"name": {"en": "Repair system files", "vi": "Sửa file hệ thống"}, "platform": "windows", "shell": "cmd", "category": {"en": "System", "vi": "Hệ thống"}, "template": "sfc /scannow",
     "purpose": {"en": "Checks protected Windows files and restores damaged ones.", "vi": "Quét file hệ thống được bảo vệ và khôi phục file hỏng."}, "notes": {"en": "Administrator prompt. If it cannot repair, run the DISM command first.", "vi": "Cần quyền Administrator. Nếu không sửa được, chạy lệnh DISM trước."}, "tags": ["repair", "sfc", "sửa lỗi"]},
    {"name": {"en": "Repair the Windows image", "vi": "Sửa image Windows (DISM)"}, "platform": "windows", "shell": "cmd", "category": {"en": "System", "vi": "Hệ thống"}, "template": "DISM /Online /Cleanup-Image /RestoreHealth",
     "purpose": {"en": "Downloads and replaces corrupted component store files.", "vi": "Tải về và thay các thành phần hệ thống bị hỏng."}, "notes": {"en": "Administrator prompt; takes several minutes.", "vi": "Cần quyền Administrator; mất vài phút."}, "tags": ["repair", "dism", "sửa lỗi"]},
    {"name": {"en": "Apply group policy now", "vi": "Áp dụng Group Policy ngay"}, "platform": "windows", "shell": "cmd", "category": {"en": "System", "vi": "Hệ thống"}, "template": "gpupdate /force",
     "purpose": {"en": "Re-reads computer and user policies from the domain.", "vi": "Đọc lại chính sách máy và người dùng từ domain."}, "tags": ["gpo", "policy", "domain"]},
    {"name": {"en": "Latest system events", "vi": "Sự kiện hệ thống mới nhất"}, "platform": "windows", "shell": "powershell", "category": {"en": "Logs", "vi": "Nhật ký"}, "template": "Get-WinEvent -LogName {log} -MaxEvents {count} | Format-Table TimeCreated,Id,LevelDisplayName,Message -AutoSize",
     "purpose": {"en": "Newest entries of an event log (System, Application, Security…).", "vi": "Các bản ghi mới nhất của một nhật ký (System, Application, Security…)."}, "tags": ["event", "log", "nhật ký", "lỗi"],
     "params": [{"key": "log", "type": "text", "default": "System", "description": {"en": "Log name", "vi": "Tên nhật ký"}}, {"key": "count", "type": "number", "default": "30", "description": {"en": "How many", "vi": "Số bản ghi"}}]},

    {"name": {"en": "Find a running program", "vi": "Tìm chương trình đang chạy"}, "platform": "windows", "shell": "cmd", "category": {"en": "Processes", "vi": "Tiến trình"}, "template": "tasklist /FI \"IMAGENAME eq {name}\"",
     "purpose": {"en": "PID and memory of every copy of a program.", "vi": "PID và bộ nhớ của mọi bản đang chạy của một chương trình."}, "tags": ["process", "pid", "tiến trình"],
     "params": [{"key": "name", "type": "text", "default": "chrome.exe", "description": {"en": "Program file name", "vi": "Tên file chương trình"}, "required": true}]},
    {"name": {"en": "End a process by PID", "vi": "Tắt tiến trình theo PID"}, "platform": "windows", "shell": "cmd", "category": {"en": "Processes", "vi": "Tiến trình"}, "template": "taskkill /PID {pid} /F",
     "purpose": {"en": "Forces a process to quit.", "vi": "Buộc tiến trình thoát ngay."}, "notes": {"en": "Unsaved work in that program is lost.", "vi": "Dữ liệu chưa lưu trong chương trình đó sẽ mất."}, "tags": ["kill", "process", "tắt"],
     "params": [{"key": "pid", "type": "number", "default": "", "description": {"en": "Process ID", "vi": "Mã tiến trình"}, "required": true}]},
    {"name": {"en": "End a program by name", "vi": "Tắt chương trình theo tên"}, "platform": "windows", "shell": "cmd", "category": {"en": "Processes", "vi": "Tiến trình"}, "template": "taskkill /IM {name} /F /T",
     "purpose": {"en": "Forces every copy of a program and its child processes to quit.", "vi": "Buộc mọi bản của chương trình và tiến trình con thoát."}, "tags": ["kill", "process", "tắt"],
     "params": [{"key": "name", "type": "text", "default": "notepad.exe", "description": {"en": "Program file name", "vi": "Tên file chương trình"}, "required": true}]},
    {"name": {"en": "Top processes by CPU", "vi": "Tiến trình tốn CPU nhất"}, "platform": "windows", "shell": "powershell", "category": {"en": "Processes", "vi": "Tiến trình"}, "template": "Get-Process | Sort-Object CPU -Descending | Select-Object -First {count} Name,Id,CPU,WorkingSet",
     "purpose": {"en": "What has used the most processor time.", "vi": "Những tiến trình dùng nhiều thời gian CPU nhất."}, "tags": ["cpu", "process", "chậm"],
     "params": [{"key": "count", "type": "number", "default": "10", "description": {"en": "How many", "vi": "Số dòng"}}]},

    {"name": {"en": "Service status", "vi": "Trạng thái dịch vụ"}, "platform": "windows", "shell": "powershell", "category": {"en": "Services", "vi": "Dịch vụ"}, "template": "Get-Service -Name {name}",
     "purpose": {"en": "Whether a service is running and how it starts.", "vi": "Dịch vụ có đang chạy không và kiểu khởi động."}, "tags": ["service", "dịch vụ"],
     "params": [{"key": "name", "type": "text", "default": "Spooler", "description": {"en": "Service name", "vi": "Tên dịch vụ"}, "required": true}]},
    {"name": {"en": "Restart a service", "vi": "Khởi động lại dịch vụ"}, "platform": "windows", "shell": "powershell", "category": {"en": "Services", "vi": "Dịch vụ"}, "template": "Restart-Service -Name {name} -Force",
     "purpose": {"en": "Stops and starts a Windows service.", "vi": "Dừng rồi chạy lại một dịch vụ Windows."}, "notes": {"en": "Administrator prompt.", "vi": "Cần quyền Administrator."}, "tags": ["service", "restart", "dịch vụ"],
     "params": [{"key": "name", "type": "text", "default": "Spooler", "description": {"en": "Service name", "vi": "Tên dịch vụ"}, "required": true}]},
    {"name": {"en": "Query a service (sc)", "vi": "Xem dịch vụ bằng sc"}, "platform": "windows", "shell": "cmd", "category": {"en": "Services", "vi": "Dịch vụ"}, "template": "sc queryex {name}",
     "purpose": {"en": "State and PID of a service; works in cmd and on Server Core.", "vi": "Trạng thái và PID của dịch vụ; chạy được trong cmd và Server Core."}, "tags": ["service", "sc", "dịch vụ"],
     "params": [{"key": "name", "type": "text", "default": "Spooler", "description": {"en": "Service name", "vi": "Tên dịch vụ"}, "required": true}]},

    {"name": {"en": "Find files by name", "vi": "Tìm file theo tên"}, "platform": "windows", "shell": "powershell", "category": {"en": "Files", "vi": "File & thư mục"}, "template": "Get-ChildItem -Path {path} -Recurse -Filter {pattern} -ErrorAction SilentlyContinue",
     "purpose": {"en": "Every file matching a pattern under a folder.", "vi": "Mọi file khớp mẫu trong một thư mục và thư mục con."}, "tags": ["find", "search", "tìm file"],
     "params": [{"key": "path", "type": "path", "default": "C:\\", "description": {"en": "Where to look", "vi": "Thư mục tìm"}, "required": true}, {"key": "pattern", "type": "text", "default": "*.log", "description": {"en": "Name pattern", "vi": "Mẫu tên"}, "required": true}]},
    {"name": {"en": "Mirror a folder (robocopy)", "vi": "Đồng bộ thư mục (robocopy)"}, "platform": "windows", "shell": "cmd", "category": {"en": "Files", "vi": "File & thư mục"}, "template": "robocopy {source} {dest} /MIR /R:2 /W:5 /MT:8",
     "purpose": {"en": "Makes dest an exact copy of source, resuming and in parallel.", "vi": "Làm thư mục đích giống hệt thư mục nguồn, chép song song và chép tiếp được."}, "notes": {"en": "/MIR deletes files in dest that are not in source.", "vi": "/MIR xóa các file ở đích không có trong nguồn."}, "tags": ["copy", "backup", "sao chép"],
     "params": [{"key": "source", "type": "path", "default": "", "description": {"en": "Source folder", "vi": "Thư mục nguồn"}, "required": true}, {"key": "dest", "type": "path", "default": "", "description": {"en": "Destination folder", "vi": "Thư mục đích"}, "required": true}]},
    {"name": {"en": "Drives and free space", "vi": "Ổ đĩa và dung lượng trống"}, "platform": "windows", "shell": "powershell", "category": {"en": "Disk", "vi": "Ổ đĩa"}, "template": "Get-PSDrive -PSProvider FileSystem",
     "purpose": {"en": "Used and free space of every drive.", "vi": "Dung lượng đã dùng và còn trống của mọi ổ."}, "tags": ["disk", "space", "dung lượng"]},
    {"name": {"en": "Check a disk for errors", "vi": "Kiểm tra lỗi ổ đĩa"}, "platform": "windows", "shell": "cmd", "category": {"en": "Disk", "vi": "Ổ đĩa"}, "template": "chkdsk {drive}: /f",
     "purpose": {"en": "Finds and fixes file system errors.", "vi": "Tìm và sửa lỗi hệ thống file."}, "notes": {"en": "For the system drive it runs at the next restart.", "vi": "Với ổ hệ thống, lệnh chạy ở lần khởi động sau."}, "tags": ["disk", "chkdsk", "lỗi"],
     "params": [{"key": "drive", "type": "text", "default": "D", "description": {"en": "Drive letter", "vi": "Ký tự ổ"}, "required": true}]},
    {"name": {"en": "Show folder permissions", "vi": "Xem quyền thư mục"}, "platform": "windows", "shell": "cmd", "category": {"en": "Files", "vi": "File & thư mục"}, "template": "icacls {path}",
