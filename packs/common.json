    {"name": {"en": "Forget a server's SSH key", "vi": "Xóa khóa SSH cũ của máy chủ"}, "platform": "both", "shell": "ssh", "category": {"en": "Network", "vi": "Mạng"}, "template": "ssh-keygen -R {host}",
