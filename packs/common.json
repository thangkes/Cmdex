    {"name": {"en": "Sign in with SSH", "vi": "Đăng nhập SSH"}, "platform": "both", "shell": "ssh", "category": {"en": "Network", "vi": "Mạng"}, "template": "ssh -p {port} {user}@{host}",
     "purpose": {"en": "Opens a command line on a remote machine.", "vi": "Mở dòng lệnh trên máy từ xa."}, "notes": {"en": "Save it as a profile under Connections to open it with one click.", "vi": "Lưu thành profile ở mục Kết nối để mở bằng một cú bấm."}, "tags": ["ssh", "remote", "từ xa", "đăng nhập"],
